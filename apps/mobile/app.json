{
  "expo": {
    "name": "Cherri",
    "slug": "cherri",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cherri",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFF6E8",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.cherri.mobile"
    },
    "android": {
      "package": "app.cherri.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#FFF6E8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF6E8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Cherri uses the microphone so you can log symptoms and talk to Cherri by voice."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cherri reads your lab report photos to explain your results.",
          "cameraPermission": "Cherri uses the camera to snap your lab report."
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}
