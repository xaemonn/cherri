{
  "name": "@cherri/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch -b swc",
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "ai:check": "tsx scripts/check-ai.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@cherri/shared": "workspace:*",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/throttler": "^6.7.1",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^6.19.3",
    "helmet": "^8.3.0",
    "minisearch": "^7.2.0",
    "openai": "^5.23.2",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.8",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.20",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.3",
    "prisma": "^6.19.3",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "unplugin-swc": "^1.6.0",
    "vitest": "^3.2.7"
  }
}
