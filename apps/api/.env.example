# ── Core ────────────────────────────────────────────────
NODE_ENV=development
PORT=4100
DATABASE_URL=postgresql://cherri:cherri@localhost:5433/cherri?schema=public
# Public URL of the web app; doctor-share links point here.
WEB_URL=http://localhost:3100
# Comma-separated origins allowed to call the API (web dev server, Expo web).
CORS_ORIGINS=http://localhost:3100,http://localhost:8081
# Set to true when deployed behind a proxy (Render, Fly, Vercel) so client IPs are correct.
TRUST_PROXY=false

# ── Security ────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
# 32 random bytes, base64. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# ── AI providers (all free tiers; add any you have) ─────
# Tried in this order; any provider without a key is skipped.
AI_PROVIDERS=groq,gemini,openrouter,ollama
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Local fallback, e.g. http://localhost:11434/v1 after `ollama pull llama3.2`
OLLAMA_BASE_URL=
# Optional model overrides (defaults are in src/ai/llm/providers.ts)
# GROQ_CHAT_MODEL=openai/gpt-oss-120b
# GROQ_FAST_MODEL=openai/gpt-oss-20b
# GEMINI_CHAT_MODEL=gemini-3.5-flash
# OLLAMA_MODEL=llama3.2
AI_DAILY_MESSAGE_LIMIT=150

# ── Care finder ─────────────────────────────────────────
OVERPASS_URL=https://overpass-api.de/api/interpreter

# ── Demo ────────────────────────────────────────────────
# Lets the app's "Try with demo data" button fill an empty account. Turn off for real users.
DEMO_MODE=true
